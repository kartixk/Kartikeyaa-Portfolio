# ==============================================================================
# .env.local — Next.js portfolio
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local — it is gitignored.
# The contact API lives inside Next.js at /api/contact — no separate server.
# ==============================================================================

# Public site URL (used for canonical links, sitemap and Open Graph)
# Set to your production domain when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (optional — contact messages are stored when set) ──
# Run supabase/schema.sql first.
# Use the SERVICE ROLE key (Project Settings → API).
# Server-only: NEVER prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend email (required for contact notifications + auto-reply) ──
RESEND_API_KEY=
RESEND_FROM=Portfolio Contact <hello@yourdomain.com>
# Comma-separated list of inboxes that receive submissions
CONTACT_RECIPIENT=you@example.com
