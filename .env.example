# ==============================================================================
# .env.local — Next.js portfolio (copy to .env.local and fill in)
# The contact API now lives inside Next.js at /api/contact — no separate server.
# ==============================================================================

# Public site URL (used for canonical links, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (optional — contact messages are stored when set). Run supabase/schema.sql first.
# Use the SERVICE ROLE key (Project Settings → API). Server-only: never prefix with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend email (required for contact notifications + auto-reply)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=Portfolio Contact <hello@kartikeyaa.me>
# Comma-separated list of inboxes that receive submissions
CONTACT_RECIPIENT=kartikeyaa15@gmail.com
